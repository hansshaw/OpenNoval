{
  "name": "ainovel-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "AI 小说创作工作台桌面版",
  "main": "main.js",
  "author": "ainovel-cli contributors",
  "license": "Apache-2.0",
  "homepage": "https://github.com/voocel/ainovel-cli",
  "desktopName": "com.ainovel.desktop",
  "scripts": {
    "build:web": "node scripts/build-sidecar.js",
    "start": "npm run build:web && electron .",
    "smoke": "npm run build:web && node scripts/test-desktop.js",
    "smoke:packaged": "node scripts/test-desktop.js --packaged",
    "test:e2e": "npm run build:web && node scripts/test-desktop.js --regression",
    "test": "node --test tests/*.test.js",
    "dist": "electron-builder --publish never",
    "dist:win": "npm run dist -- --win",
    "dist:linux": "npm run dist -- --linux"
  },
  "devDependencies": {
    "electron": "44.9.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.ainovel.desktop",
    "productName": "AI Novel Studio",
    "asar": true,
    "beforePack": "scripts/before-pack.js",
    "artifactName": "${name}-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "database.js",
      "security.js",
      "sidecar-lifecycle.js",
      "workspace.js",
      "test-environment.js",
      "scripts/desktop-checks.js",
      "preload.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "bin/${os}/${arch}",
        "to": "bin",
        "filter": [
          "ainovel-sidecar",
          "ainovel-sidecar.exe"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "${name}-${version}-win-${arch}-setup.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Office",
      "syncDesktopName": true,
      "maintainer": "ainovel-cli contributors"
    }
  }
}
