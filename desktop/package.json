{
  "name": "ainovel-desktop",
  "version": "0.1.3",
  "private": true,
  "description": "AI 小说创作、手动写作与多格式整本阅读工作台",
  "main": "main.js",
  "author": "hansshaw",
  "license": "AGPL-3.0-only",
  "homepage": "https://github.com/hansshaw/OpenNovel",
  "desktopName": "com.ainovel.desktop",
  "scripts": {
    "build:sidecar": "npm run vendor:check && node scripts/build-sidecar.js",
    "start": "npm run build:sidecar && electron .",
    "smoke": "npm run build:sidecar && node scripts/test-desktop.js",
    "smoke:packaged": "node scripts/test-desktop.js --packaged",
    "test:e2e": "npm run build:sidecar && node scripts/test-desktop.js --regression",
    "test": "node --test tests/*.test.js",
    "dist": "electron-builder --publish never",
    "dist:win": "npm run dist -- --win",
    "dist:linux": "npm run dist -- --linux",
    "vendor:reader": "node scripts/sync-reader-vendor.js",
    "vendor:check": "node scripts/sync-reader-vendor.js --check"
  },
  "devDependencies": {
    "electron": "44.9.1",
    "electron-builder": "26.18.0",
    "pdfjs-dist": "6.4.299"
  },
  "build": {
    "appId": "com.ainovel.desktop",
    "productName": "AI Novel Studio",
    "asar": true,
    "beforePack": "scripts/before-pack.js",
    "artifactName": "${name}-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "database.js",
      "appearance-preferences.js",
      "export-files.js",
      "security.js",
      "sidecar-lifecycle.js",
      "workspace.js",
      "test-environment.js",
      "scripts/desktop-checks.js",
      "scripts/dynamic-background-checks.js",
      "scripts/chapter-scroll-checks.js",
      "scripts/media-checks.js",
      "scripts/fixtures/*",
      "preload.js",
      "package.json",
      "scripts/reader-checks.js"
    ],
    "extraResources": [
      {
        "from": "bin/${os}/${arch}",
        "to": "bin",
        "filter": [
          "ainovel-sidecar",
          "ainovel-sidecar.exe"
        ]
      },
      {
        "from": "../LICENSE",
        "to": "licenses/LICENSE"
      },
      {
        "from": "../NOTICE",
        "to": "licenses/NOTICE"
      },
      {
        "from": "../LICENSES",
        "to": "licenses/third-party"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "guid": "e8db1337-b330-59d5-a41f-5283be9b2bcf",
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "artifactName": "${name}-${version}-win-${arch}-setup.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Office",
      "syncDesktopName": true,
      "maintainer": "hansshaw"
    }
  }
}
