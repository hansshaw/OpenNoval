{
  "name": "ainovel-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "AI 小说创作工作台桌面版",
  "main": "main.js",
  "author": "ainovel-cli contributors",
  "license": "Apache-2.0",
  "scripts": {
    "build:web": "node scripts/build-sidecar.js",
    "start": "npm run build:web && electron .",
    "smoke": "npm run build:web && electron . --smoke-test",
    "test": "node --test tests/*.test.js",
    "dist": "npm run build:web && electron-builder"
  },
  "devDependencies": {
    "electron": "44.9.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.ainovel.desktop",
    "productName": "AI Novel Studio",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "database.js",
      "security.js",
      "preload.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "bin",
        "to": "bin",
        "filter": [
          "ainovel-sidecar*"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
