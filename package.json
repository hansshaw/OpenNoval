{
  "name": "ainovel-workbench",
  "private": true,
  "scripts": {
    "start": "npm --prefix desktop start",
    "build:sidecar": "npm --prefix desktop run build:sidecar",
    "test": "npm --prefix desktop test",
    "smoke": "npm --prefix desktop run smoke",
    "test:e2e": "npm --prefix desktop run test:e2e",
    "smoke:packaged": "npm --prefix desktop run smoke:packaged",
    "dist": "npm --prefix desktop run dist --",
    "dist:win": "npm --prefix desktop run dist:win --",
    "dist:linux": "npm --prefix desktop run dist:linux --",
    "android:doctor": "bash mobile/scripts/doctor.sh",
    "android:build": "bash mobile/scripts/build-apk.sh debug",
    "android:release": "bash mobile/scripts/build-apk.sh release && bash mobile/scripts/sign-release.sh"
  },
  "license": "AGPL-3.0-only",
  "author": "hansshaw"
}
